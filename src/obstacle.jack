class Obstacle {
    field int x, y;
    field int width, height;

    constructor Obstacle new(int startX, int startY) {
        let x = startX;
        let y = startY;
        let width = 78;
        let height = 20;

        do draw();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method boolean isDrawable() {
        return (y > 0) & ((y + height) < 256);
    }

    method void draw() {
        if (isDrawable()) {
            do Screen.setColor(true);

            do Screen.drawRectangle(x + 8, y + 12, x + 70, y + 18);
            do Screen.drawRectangle(x + 16, y + 8, x + 34, y + 16);
            do Screen.drawRectangle(x + 30, y + 4, x + 52, y + 18);
            do Screen.drawRectangle(x + 50, y + 8, x + 66, y + 16);
            do Screen.drawRectangle(x, y + 14, x + 14, y + 18);
            do Screen.drawRectangle(x + 64, y + 14, x + 78, y + 18);
        }

        return;
    }

    method void erase() {
        if (isDrawable()) {
            do Screen.setColor(false);
            do Screen.drawRectangle(x, y, x + width, y + height);
        }

        return;
    }

    method void moveDown(int amount) {
        do erase();

        let y = y + amount;

        do draw();

        return;
    }

    method void setPosition(int newX, int newY) {
        do erase();

        let x = newX;
        let y = newY;

        do draw();

        return;
    }

    method int getX() {
        return x;
    }

    method int getY() {
        return y;
    }

    method int getWidth() {
        return width;
    }

    method int getHeight() {
        return height;
    }

    method int getCenterX() {
        return x + (width / 2);
    }
}